extends SceneTree
var passed=0
var failed=0
var w
const G=preload("res://scripts/room_geometry.gd")
func check(value: bool,description: String):
	if value:passed+=1;print("PASS "+description)
	else:failed+=1;push_error("FAIL "+description)
func _initialize():call_deferred("run")
func tile(x: int,y: int,value: int=3):w.command("tile",{"x":x,"y":y,"tile":value})
func fixture():
	w.reset_starter();w.data.get("automation",{}).merge({"auto_initiative":false},true);w.command("new_campaign",{"title":"Room tests","heroes":true});w.encounter.ensure_data();w.data.automation.auto_initiative=false
	w.command("resize",{"width":13,"height":9})
	for a in w.data.actors:a.x=3;a.y=4
	# Two rooms share a north/south wall with a portal at G5.
	for x in range(1,12):tile(x,1);tile(x,7)
	for y in range(2,7):tile(1,y);tile(11,y);tile(6,y)
	tile(6,4,6);tile(3,1,6)
	w.mark_changed()
func run():
	await process_frame;w=root.get_node("World")
	fixture()
	check(w.scene().get("room_visibility",false),"Construction automatically enables room concealment")
	check(w.room_info.count==2,"Two enclosed rooms detected")
	check(w.cell_visible(Vector2i(3,4)) and not w.cell_visible(Vector2i(8,4)),"Occupied room visible, adjacent room concealed")
	check(not w.cell_visible(Vector2i(0,4)),"Exterior concealed from indoor party")
	check(w.cell_visible(Vector2i(6,4)) and w.cell_visible(Vector2i(1,1)),"Door and closed corner boundaries visible")
	check(is_equal_approx(G.door_angle(w.scene(),Vector2i(6,4)),PI/2),"Vertical wall automatically turns doorway 90 degrees")
	check(is_equal_approx(G.door_angle(w.scene(),Vector2i(3,1)),0),"Horizontal doorway aligns with wall")
	check(G.connections(w.scene(),Vector2i(1,1)).size()==2,"Corner detects both connected arms")
	var foe=w.read_json("res://assets/starter.json",{}).actors[4].duplicate(true)
	foe.id="room_enemy";foe.scene=w.data.scene;foe.x=8;foe.y=4;w.data.actors.append(foe);w.mark_changed()
	check(not w.player_snapshot().actors.any(func(a):return a.id==foe.id),"Concealed enemy sheet omitted from player snapshot")
	check(w.player_snapshot().scenes[0].room_mask.has("8,4"),"Host transmits authoritative room mask")
	w.command("door",{"x":6,"y":4})
	check(w.cell_visible(Vector2i(8,4)) and not w.cell_visible(Vector2i(0,4)),"Open interior door reveals connected room only")
	check(w.player_snapshot().actors.any(func(a):return a.id==foe.id),"Opening door includes newly visible enemy")
	w.command("door",{"x":6,"y":4})
	check(not w.cell_visible(Vector2i(8,4)),"Closing door conceals room again")
	w.undo();check(w.cell_visible(Vector2i(8,4)),"Undo restores door state and visibility")
	w.command("door",{"x":3,"y":1})
	check(w.cell_visible(Vector2i(0,4)),"Open exterior door reveals outdoor region")
	w.command("fog",{"x":8,"y":4,"hide":true})
	check(not w.cell_visible(Vector2i(8,4)),"Manual fog remains an additional concealment layer")
	w.command("fog_all",{"hide":false})
	check(w.cell_visible(Vector2i(8,4)),"Clearing manual fog preserves open-door visibility")
	w.command("door",{"x":6,"y":4})
	w.command("room_visibility",{"enabled":false})
	check(w.cell_visible(Vector2i(8,4)),"DM can disable automatic concealment")
	tile(2,1);check(not w.scene().room_visibility,"Explicit off setting survives later construction")
	w.command("room_visibility",{"enabled":true})
	check(not w.cell_visible(Vector2i(8,4)),"Re-enabling concealment applies closed boundaries")
	w.actor("hero2").x=8;w.mark_changed()
	check(w.cell_visible(Vector2i(8,4)),"Separated party shares visibility from both rooms")
	w.actor("hero2").x=3;w.mark_changed()
	var save="user://rooms_roundtrip.json";w.save_campaign(save);w.load_campaign(save)
	check(not w.cell_visible(Vector2i(8,4)) and w.scene().doors_open.get("3,1",false),"Saved campaign restores room mode, doors and derived visibility")
	# Ownership, reach and wall crossing are enforced by the host.
	w.peers[42]=true;var hero=w.actor("hero1");hero.owner=42
	w.apply_command("door",{"id":hero.id,"x":6,"y":4},42)
	check(not w.scene().doors_open.get("6,4",false),"Player cannot toggle a distant door")
	w.command("move",{"id":hero.id,"x":5,"y":4})
	w.apply_command("move",{"id":hero.id,"x":8,"y":4},42)
	check(hero.x==5,"Player cannot cross a closed doorway")
	w.apply_command("door",{"id":"hero2","x":6,"y":4},42)
	check(not w.scene().doors_open.get("6,4",false),"Player cannot use an unassigned hero to open a door")
	w.apply_command("door",{"id":hero.id,"x":6,"y":4},42)
	check(w.scene().doors_open.get("6,4",false) and w.cell_visible(Vector2i(8,4)),"Adjacent assigned hero opens the door")
	w.apply_command("move",{"id":hero.id,"x":7,"y":4},42)
	check(hero.x==7,"Player moves through an open doorway into an unoccupied square")
	w.apply_command("move",{"id":hero.id,"x":8,"y":0},42)
	check(hero.y==0 and hero.get("last_path",[]).all(func(point):return not w.ROOMS.blocked(w.scene(),Vector2i(point.x,point.y))),"Player follows a clear routed path around walls to a visible destination")
	w.command("move",{"id":hero.id,"x":0,"y":0})
	check(hero.x==0 and hero.y==0,"DM retains free repositioning")
	w.peers={}
	# Broken boundaries, corners, footprints and empty maps.
	fixture();tile(6,4,1)
	check(w.cell_visible(Vector2i(8,4)),"Removing a door opens the room boundary")
	check(not w.scene().get("doors_open",{}).has("6,4"),"Repainting removes stale door state")
	tile(1,4,1)
	check(w.room_info.count==0 and w.room_info.concealed.is_empty(),"Unfinished enclosure leaves the map visible")
	fixture();var s=w.scene()
	check(not G.clear_path(s,Vector2i(5,3),Vector2i(7,5),1),"Diagonal movement cannot cut a blocked corner")
	check(not G.clear_footprint(s,Vector2i(5,3),2),"Large footprint respects wall occupancy")
	for a in w.data.actors:a.dead=true
	w.mark_changed()
	check(w.cell_visible(Vector2i(3,4)) and not w.cell_visible(Vector2i(8,4)),"No active heroes uses the first enclosed room as preview anchor")
	w.command("new_campaign",{"heroes":false});w.encounter.ensure_data();w.data.automation.auto_initiative=false;tile(2,2);tile(3,2,6)
	check(not w.room_info.active and w.room_info.count==0,"Loose wall and door pieces do not conceal the entire map")
	print("ROOM_RESULT "+str(passed)+" passed, "+str(failed)+" failed")
	quit(1 if failed else 0)

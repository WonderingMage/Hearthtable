extends SceneTree
var w
var passed=0
var failed=0
const B=preload("res://scripts/build_system.gd")
const M=preload("res://scripts/build_models.gd")
func _initialize():call_deferred("run")
func check(ok: bool,note: String):
	if ok:passed+=1;print("PASS "+note)
	else:failed+=1;push_error("FAIL "+note)
func edit(p: Dictionary):w.command("build_edit",p)
func run():
	await process_frame;w=root.get_node("World");w.reset_starter();w.command("new_campaign",{"heroes":false});w.command("resize",{"width":30,"height":24})
	B.ensure();check(B.catalog.size()==77,"Build catalog contains 77 original items")
	var categories={};var bad=[]
	for d in B.catalog.values():
		categories[d.category]=true;var node=M.make(d)
		if node.get_child_count()==0:bad.append(d.id)
		node.free()
	check(categories.size()==9 and bad.is_empty(),"All nine categories create real 3D geometry")
	check(w.valid_campaign(w.data),"Older campaigns without build fields still validate")
	edit({"op":"room","asset":"wall","x":2,"y":2,"ex":10,"ey":10})
	check(w.scene().tiles.size()==32 and w.room_info.count>=1,"Dragging a room creates connected sealing walls in one operation")
	edit({"op":"place","asset":"door","x":6,"y":10})
	check(w.scene().tiles["6,10"]==6,"Door placement cuts a portal into an existing wall")
	var before=w.scene().tiles.size();edit({"op":"place","asset":"door","x":15,"y":15})
	check(w.scene().tiles.size()==before,"A door cannot float away from a wall")
	edit({"op":"area","asset":"marble","x":3,"y":3,"ex":9,"ey":9})
	check(w.scene().surfaces.size()==49,"Drag flooring covers a rectangle with calibrated cells")
	edit({"op":"place","asset":"throne","x":5,"y":4,"rotation":0,"swatch":3})
	check(w.scene().props.size()==1 and w.ROOMS.blocked(w.scene(),Vector2i(5,4)),"Placed furniture records its design and blocks walking")
	var id=w.scene().props[0].uid;edit({"op":"place","asset":"table","x":5,"y":4})
	check(w.scene().props.size()==1,"Overlapping solid furniture is rejected without spending history")
	edit({"op":"move","uid":id,"x":6,"y":6,"rotation":1,"swatch":2})
	check(w.scene().props[0].x==6 and w.scene().props[0].swatch==2,"Pickup/move preserves object identity and applies rotation/swatches")
	check(not w.ROOMS.blocked(w.scene(),Vector2i(5,4)),"Moving an object immediately clears its old collision footprint")
	w.undo();check(w.scene().props[0].x==5,"Undo restores the full prior furniture placement")
	edit({"op":"delete","uid":id})
	check(w.scene().props.is_empty() and not w.ROOMS.blocked(w.scene(),Vector2i(5,4)),"Bulldozing removes both the model data and walking obstacle")
	edit({"op":"area","asset":"lava","x":13,"y":5,"ex":20,"ey":8})
	check(w.ROOMS.blocked(w.scene(),Vector2i(15,6)),"Walking avoids dangerous lava cells")
	edit({"op":"place","asset":"bridge","x":14,"y":6})
	check(not w.ROOMS.blocked(w.scene(),Vector2i(15,6)),"A placed bridge opens a traversable route across the hazard")
	check(w.ROOMS.blocked(w.scene(),Vector2i(15,5)),"The surrounding hazard remains impassable to ordinary walking")
	var d=B.definition("table");check(B.footprint(d,0)==Vector2i(3,1) and B.footprint(d,1)==Vector2i(1,3),"Rotating a non-square object rotates its collision footprint")
	check(not w.builder.assessment("volcano",Vector2i(28,20),0).ok,"Multi-cell props cannot extend past map bounds")
	var pack=w.SCENE_FILES.package_scene(w,w.data.scene);var imported=w.SCENE_FILES.import_package(w,pack)
	check(imported.ok and imported.scene.props.size()==1 and imported.scene.surfaces.has("15,6"),"Scene packages preserve objects, swatches, terrain and hazard surfaces")
	var badscene=w.scene().duplicate(true);badscene.props[0].asset="unknown";check(not B.valid_scene(badscene),"Unknown imported object definitions are refused")
	badscene=w.scene().duplicate(true);badscene.props.append(badscene.props[0]);check(not B.valid_scene(badscene),"Duplicate object identities are refused")
	var total=w.scene().props.size();w.apply_command("build_edit",{"op":"delete","uid":w.scene().props[0].uid},42);check(w.scene().props.size()==total,"Remote players cannot change build data")
	for theme in ["Throne hall","Volcanic crossing","Tidal ruins","Woodland camp","Frozen pass"]:
		var s=B.template_scene(theme);check(B.valid_scene(s) and s.props.size()>0,theme+" creates a valid populated editable scene")
	w.command("new_campaign",{"heroes":false});var a=w.read_json("res://assets/loadouts.json",{}).Fighter.duplicate(true);a.id="a";a.scene=w.data.scene;a.x=2;a.y=5
	var b=a.duplicate(true);b.id="b";b.hero=false;b.x=8;w.data.actors=[a,b];w.mark_changed()
	edit({"op":"place","asset":"bookcase","x":5,"y":5})
	check(not w.COMBAT.line_clear(w.scene(),Vector2i(2,5),Vector2i(8,5),a,b),"Tall objects block actual attack lines at their modeled height")
	edit({"op":"delete","uid":w.scene().props[0].uid})
	check(w.COMBAT.line_clear(w.scene(),Vector2i(2,5),Vector2i(8,5),a,b),"Removing a tall object restores the attack line")
	edit({"op":"height","x":2,"y":5,"feet":5});check(a.elevation_ft==5,"Terrain raise updates a creature standing on the square")
	w.undo();check(w.actor("a").get("elevation_ft",0)==0,"Undo restores creature and terrain elevation together")
	edit({"op":"template","theme":"Volcanic crossing"});check(w.data.actors.filter(func(unit):return unit.hero).all(func(unit):return unit.scene==w.data.scene and w.ROOMS.clear_footprint(w.scene(),Vector2i(unit.x,unit.y),1)),"Themed scene activation places heroes on safe walkable landing cells")
	check(w.valid_campaign(w.data),"Build edits preserve full campaign serialization")
	print("BUILD_RESULT "+str(passed)+" passed, "+str(failed)+" failed");quit(1 if failed else 0)
